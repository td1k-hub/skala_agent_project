PUMP_GUARD_DATABASE_PATH=data/pump_guard.sqlite3
PUMP_GUARD_CORS_ORIGINS=["http://localhost:5173"]
PUMP_GUARD_ANALYSIS_TIMEOUT_SECONDS=300
PUMP_GUARD_HEARTBEAT_SECONDS=10
PUMP_GUARD_MAX_BODY_BYTES=16384
PUMP_GUARD_LLM_MODE=openai
# Set this locally in backend/.env. Never commit or paste the real key.
OPENAI_API_KEY=
PUMP_GUARD_OPENAI_MODEL=gpt-5.4-mini
PUMP_GUARD_OPENAI_TIMEOUT_SECONDS=120
PUMP_GUARD_OPENAI_MAX_OUTPUT_TOKENS=4096
# Optional legacy local provider settings (only used when mode=ollama).
PUMP_GUARD_OLLAMA_BASE_URL=http://127.0.0.1:11434
PUMP_GUARD_OLLAMA_MODEL=qwen3:8b
PUMP_GUARD_OLLAMA_TIMEOUT_SECONDS=120
PUMP_GUARD_OLLAMA_NUM_CTX=8192
PUMP_GUARD_OLLAMA_NUM_PREDICT=1024
PUMP_GUARD_MAX_CONCURRENT_ANALYSES=2
PUMP_GUARD_MAX_CONCURRENT_LLM=1
# Put your LangSmith key below, then set tracing=true. Never commit this file with a real key.
# Trace inputs and outputs are redacted before upload.
PUMP_GUARD_LANGSMITH_TRACING=false
PUMP_GUARD_LANGSMITH_API_KEY=
PUMP_GUARD_LANGSMITH_PROJECT=pump-guard
PUMP_GUARD_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Only needed when the key belongs to multiple LangSmith workspaces.
PUMP_GUARD_LANGSMITH_WORKSPACE_ID=
PUMP_GUARD_AGENT_MAX_TURNS=4
PUMP_GUARD_AGENT_MAX_REVISIONS=1
